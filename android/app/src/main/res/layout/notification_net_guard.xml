<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="0dp"
    android:paddingBottom="0dp">

    <!-- Start / Stop Button on the End Side (Adaptive with high-contrast text) -->
    <TextView
        android:id="@+id/btn_notif_vpn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="8dp"
        android:layout_marginLeft="8dp"
        android:background="@drawable/bg_notif_btn_green"
        android:gravity="center"
        android:minHeight="28dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="⚡ تشغيل"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Left / Start side: Speeds and Daily Data Usage (System-Adaptive Colors) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:layout_toStartOf="@id/btn_notif_vpn"
        android:layout_toLeftOf="@id/btn_notif_vpn"
        android:layout_centerVertical="true"
        android:orientation="vertical">

        <!-- Line 1: Download & Upload Speeds (Pure High-Contrast White) -->
        <TextView
            android:id="@+id/tv_notif_line1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:padding="0dp"
            android:text="↓ 0.0 KB/s    •    ↑ 0.0 KB/s"
            android:textColor="#FFFFFF"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:textDirection="locale"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- Line 2: WiFi & Mobile Data Usage (Bright High-Contrast Silver White) -->
        <TextView
            android:id="@+id/tv_notif_line2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:includeFontPadding="false"
            android:padding="0dp"
            android:text="واي فاي: 0.0 MB   •   بيانات: 0.0 MB"
            android:textColor="#E0E0E0"
            android:textSize="11sp"
            android:textDirection="locale"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

</RelativeLayout>
